{
  "name": "airbrake_deploys",
  "description": "Airbrake deploys: list, get, or create a deploy marker. deploy_id MUST be passed as a string (19-digit snowflake). Returns the raw Airbrake JSON payload — no data is removed.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "get",
          "create"
        ]
      },
      "project_id": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "default": 1
      },
      "per_page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "deploy_id": {
        "type": "string",
        "pattern": "^\\d+$"
      },
      "deploy": {
        "type": "object",
        "additionalProperties": {}
      }
    },
    "additionalProperties": false,
    "required": [
      "action",
      "project_id"
    ]
  }
}
