{
  "name": "airbrake_notify",
  "title": "Send a notice to Airbrake (Notifier API)",
  "description": "Send a notice (error report) TO Airbrake via the Notifier API. Requires AIRBRAKE_PROJECT_KEYS[project_id] to be set. Disabled when AIRBRAKE_READ_ONLY is set. Returns the raw Airbrake JSON payload — no data is removed.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "const": "notify"
      },
      "project_id": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "payload": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "errors"
        ],
        "additionalProperties": {}
      }
    },
    "additionalProperties": false,
    "required": [
      "action",
      "project_id",
      "payload"
    ]
  },
  "annotations": {
    "title": "Send a notice to Airbrake (Notifier API)",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  }
}
